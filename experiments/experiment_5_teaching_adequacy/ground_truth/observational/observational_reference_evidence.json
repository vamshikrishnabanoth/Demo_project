      "observed_dimensions": {
        "IDENTIFICATION": {
          "level": 2,
          "evidence": "A x = lambda x. The non-zero vector x is called an eigenvector... lambda is the eigenvalue."
        },
        "MEANING": {
          "level": 4,
          "evidence": "multiplying by the matrix does not change the vector's direction; it only scales it by some constant number lambda."
        },
        "STRUCTURE_COMPONENTS": {
          "level": 4,
          "evidence": "characteristic polynomial: lambda^2 - lambda - 2 = (lambda - 2)(lambda + 1) = 0."
        },
        "RELATIONSHIPS_MECHANISM": {
          "level": 5,
          "evidence": "(A - lambda I) x = 0... matrix must be singular! And a matrix is singular if and only if its determinant is zero."
        },
        "JUSTIFICATION_WHY": {
          "level": 5,
          "evidence": "We are looking for an eigenvector x that is NOT the zero vector... non-zero vector x in the nullspace of (A - lambda I)."
        },
        "APPLICATION_INTERPRETATION": {
          "level": 6,
          "evidence": "A = [4, -5; 2, -3]... lambda_1 = 2 with v_1 = [5, 2]^T, lambda_2 = -1 with v_2 = [1, 1]^T."
        },
        "BOUNDARIES_EXCEPTIONS": {
          "level": 4,
          "evidence": "90-degree rotation matrix... no real vector can stay parallel... eigenvalues are imaginary, plus and minus i."
        },
        "TRANSFER_SYNTHESIS": {
