# Server Configuration
PORT=5000

# Database
DATABASE_URL=your-database-url-here

# JWT Secret
JWT_SECRET=your-jwt-secret-here

# AI APIs for Quiz Generation
OPENAI_API_KEY=your-openai-key-here

# Audio Transcription (for voice-to-quiz feature)
GROQ_API_KEY=your-groq-key-here

# YouTube Video Processing (OPTIONAL - enables AI fallback for videos without captions)
# Get free key from: https://makersuite.google.com/app/apikey
# Without this key: Works for videos with captions or descriptions (~80-90% success)
# With this key: Works for ALL videos (~99% success)
GEMINI_API_KEY=your-gemini-key-here

# Rate Limiting (for development)
DISABLE_LIMITS=false
