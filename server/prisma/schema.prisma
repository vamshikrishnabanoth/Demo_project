// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id               String   @id @default(uuid())
  username         String   @unique
  email            String   @unique
  password         String
  role             String   @default("none") // 'teacher', 'student', 'admin', 'none'
  name             String?
  tokenVersion     Int      @default(0)
  isSuspended      Boolean  @default(false)
  suspensionReason String?
  suspendedUntil   DateTime?
  violationCount   Int      @default(0)
  isOnline         Boolean  @default(false)
  studentBranch    String?
  section          String?
  year             String?
  semester         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  lastLogin        DateTime?
  
  // Progressive Account Lockout (Brute Force Protection)
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  lastFailedLoginAt   DateTime?
  
  // Gamification Fields
  xp                  Int       @default(0)
  streak              Int       @default(0)
  highestStreak       Int       @default(0)
  streakSavesUsed     Int       @default(0)
  lastStreakSaveWeek  DateTime? 
  lastStreakDate      DateTime? // The date the streak was last incremented
  dailyMissions       Json?     // Stores generated missions for the day and progress
  lastMissionsDate    DateTime? // Used to reset missions daily
  unlockedPerks       Json?     // Array of redeemed perks

  quizzes          Quiz[]
  results          Result[]
  broadcastsSent   Broadcast[]
  cheatingLogs     CheatingLog[]
}

model Quiz {
  id               String   @id @default(uuid())
  title            String
  description      String?
  questions        Json     // Stores the array of questions
  createdBy        User     @relation(fields: [createdById], references: [id])
  createdById      String
  isActive         Boolean  @default(true)
  joinCode         String?  @unique
  difficulty       String   @default("Medium")
  timerPerQuestion Int      @default(30)
  duration         Int      @default(0)
  timerType        String   @default("timePerQuestion") // 'timePerQuestion' or 'totalTime'
  accessType       String   @default("private")         // 'private' or 'public'
  startTime        DateTime?
  endTime          DateTime?
  broadcastStatus     Boolean   @default(false)
  autoBroadcast       Boolean   @default(true)
  joinedStudentsCount Int       @default(0)
  attemptCount        Int       @default(0)
  scheduleLocked      Boolean   @default(false)
  lastScheduleEditAt  DateTime?
  lastEditedBy        String?
  topic            String?
  isLive           Boolean  @default(false)
  isAssessment     Boolean  @default(false)
  status           String   @default("waiting") // 'waiting', 'started', 'finished'
  assignedGroups   Json?    // Stores targeting parameters e.g. [{ branch: 'CSE', section: 'A' }]
  assignedStudents String[] @default([]) // Selected User IDs
  createdAt        DateTime @default(now())
  finalLeaderboard Json?    // Stores the leaderboard array
  finalInsights    Json?    // Stores the insights object
  lobbySummary     String?  // Bulleted RAG summary for real-time wait lobby study panel
  aiFlashcards     Json?    // Array of AI flashcards for student revision hub
  // ── Integrity & Immutability ──────────────────────────────────────────────
  isLocked         Boolean  @default(false)  // true after teacher publishes — questions frozen
  quizHash         String?                   // SHA-256 of canonical frozen payload
  publishedAt      DateTime?                 // when teacher finalized and published
  publishedBy      String?                   // userId of teacher who published
  version          Int      @default(1)      // payload version counter (increments on each publish)
  results          Result[]
  broadcasts       Broadcast[]
  cheatingLogs     CheatingLog[]

  @@index([createdById])                 // teacher's quiz list queries
  @@index([status])                      // scheduler filter
  @@index([startTime])                   // scheduler start filter
  @@index([isActive])                    // scheduler end filter
  @@index([isLive, status])              // live quiz queries
}

model Result {
  id             String    @id @default(uuid())
  quiz           Quiz      @relation(fields: [quizId], references: [id])
  quizId         String
  student        User      @relation(fields: [studentId], references: [id])
  studentId      String
  score          Int       @default(0)
  totalQuestions Int
  totalTimeTaken Int       @default(0)
  answers        Json      // Stores the answers array
  status         String    @default("in-progress") // 'in-progress', 'completed'
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  lastAnsweredAt DateTime  @default(now())

  @@unique([quizId, studentId])
  @@index([quizId])      // analytics queries filter by quizId
  @@index([studentId])   // student history queries filter by studentId
  @@index([status])      // filter completed vs in-progress
}

model Broadcast {
  id               String   @id @default(uuid())
  sender           User     @relation(fields: [senderId], references: [id])
  senderId         String
  quiz             Quiz     @relation(fields: [quizId], references: [id])
  quizId           String
  title            String
  message          String
  pin              String?
  assignedGroups   Json?
  assignedStudents String[] @default([])
  createdAt        DateTime @default(now())
  expiresAt        DateTime?
  readBy           String[] @default([])
  isPinned         Boolean  @default(false)
  scheduledFor     DateTime?
  deliveryStatus   String   @default("delivered") // 'delivered', 'scheduled', 'expired'

  @@index([quizId])         // list broadcasts for a quiz
  @@index([senderId])       // list broadcasts sent by a teacher
  @@index([deliveryStatus]) // filter scheduled/delivered broadcasts
}

model DocumentChunk {
  id         String                    @id @default(uuid())
  content    String
  embedding  Unsupported("vector(384)")?
  source     String
  sourceType String                    @default("SESSION") // 'SESSION' or 'COLLEGE'
  metadata   Json?
  createdAt  DateTime                  @default(now())
}

model TeacherFeedback {
  id                  String   @id @default(uuid())
  teacherId           String
  quizId              String?
  questionId          String?
  actionType          String   // 'accepted_without_edits', 'edited_distractor', 'corrected_difficulty', 'deleted'
  originalQuestion    Json?
  modifiedQuestion    Json?
  metadata            Json?
  createdAt           DateTime @default(now())
}

model QuizSession {
  id               String   @id @default(uuid())
  title            String
  sourceMaterialId String?
  totalQuestions   Int
  targetRatios     Json     // Stores target flavor ratios: { theory, code_debugging, fill_blank, scenario }
  questions        Json     // Stores array of questions conforming to the structured schema
  isActive         Boolean  @default(true)
  joinCode         String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

model CheatingLog {
  id                String   @id @default(uuid())
  quizId            String
  studentId         String
  action            String
  details           Json?
  studentName       String?
  studentRollNumber String?
  timestamp         DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([studentId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  adminId   String
  adminName String?
  action    String   // e.g. 'STUDENT_CREATED', 'USER_DELETED', 'SEMESTER_PROMOTED'
  target    String?  // target user display name or entity name
  targetId  String?  // target user ID
  details   Json?    // { role, oldValue, newValue, count, ... }
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}
