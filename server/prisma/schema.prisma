// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(uuid())
  username         String   @unique
  email            String   @unique
  password         String
  role             String   @default("none") // 'teacher', 'student', 'admin', 'none'
  name             String?
  tokenVersion     Int      @default(0)
  isSuspended      Boolean  @default(false)
  suspensionReason String?
  isOnline         Boolean  @default(false)
  studentBranch    String?
  section          String?
  year             String?
  semester         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  lastLogin        DateTime?
  
  // Gamification Fields
  xp                  Int       @default(0)
  streak              Int       @default(0)
  highestStreak       Int       @default(0)
  streakSavesUsed     Int       @default(0)
  lastStreakSaveWeek  DateTime? 
  lastStreakDate      DateTime? // The date the streak was last incremented
  dailyMissions       Json?     // Stores generated missions for the day and progress
  lastMissionsDate    DateTime? // Used to reset missions daily
  unlockedPerks       Json?     // Array of redeemed perks

  quizzes          Quiz[]
  results          Result[]
  broadcastsSent   Broadcast[]
}

model Quiz {
  id               String   @id @default(uuid())
  title            String
  description      String?
  questions        Json     // Stores the array of questions
  createdBy        User     @relation(fields: [createdById], references: [id])
  createdById      String
  isActive         Boolean  @default(true)
  joinCode         String?  @unique
  difficulty       String   @default("Medium")
  timerPerQuestion Int      @default(30)
  duration         Int      @default(0)
  timerType        String   @default("timePerQuestion") // 'timePerQuestion' or 'totalTime'
  accessType       String   @default("private")         // 'private' or 'public'
  startTime        DateTime?
  endTime          DateTime?
  broadcastStatus     Boolean   @default(false)
  autoBroadcast       Boolean   @default(true)
  joinedStudentsCount Int       @default(0)
  attemptCount        Int       @default(0)
  scheduleLocked      Boolean   @default(false)
  lastScheduleEditAt  DateTime?
  lastEditedBy        String?
  topic            String?
  isLive           Boolean  @default(false)
  isAssessment     Boolean  @default(false)
  status           String   @default("waiting") // 'waiting', 'started', 'finished'
  assignedGroups   Json?    // Stores targeting parameters e.g. [{ branch: 'CSE', section: 'A' }]
  assignedStudents String[] @default([]) // Selected User IDs
  createdAt        DateTime @default(now())
  finalLeaderboard Json?    // Stores the leaderboard array
  finalInsights    Json?    // Stores the insights object
  // ── Integrity & Immutability ──────────────────────────────────────────────
  isLocked         Boolean  @default(false)  // true after teacher publishes — questions frozen
  quizHash         String?                   // SHA-256 of canonical frozen payload
  publishedAt      DateTime?                 // when teacher finalized and published
  publishedBy      String?                   // userId of teacher who published
  version          Int      @default(1)      // payload version counter (increments on each publish)
  results          Result[]
  broadcasts       Broadcast[]
}

model Result {
  id             String    @id @default(uuid())
  quiz           Quiz      @relation(fields: [quizId], references: [id])
  quizId         String
  student        User      @relation(fields: [studentId], references: [id])
  studentId      String
  score          Int       @default(0)
  totalQuestions Int
  totalTimeTaken Int       @default(0)
  answers        Json      // Stores the answers array
  status         String    @default("in-progress") // 'in-progress', 'completed'
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  lastAnsweredAt DateTime  @default(now())

  @@unique([quizId, studentId])
}

model Broadcast {
  id               String   @id @default(uuid())
  sender           User     @relation(fields: [senderId], references: [id])
  senderId         String
  quiz             Quiz     @relation(fields: [quizId], references: [id])
  quizId           String
  title            String
  message          String
  pin              String?
  assignedGroups   Json?
  assignedStudents String[] @default([])
  createdAt        DateTime @default(now())
  expiresAt        DateTime?
  readBy           String[] @default([])
  isPinned         Boolean  @default(false)
  scheduledFor     DateTime?
  deliveryStatus   String   @default("delivered") // 'delivered', 'scheduled', 'expired'
}
