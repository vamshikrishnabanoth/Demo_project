// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id               String   @id @default(uuid())
  username         String   @unique
  email            String   @unique
  password         String
  role             String   @default("none") // 'teacher', 'student', 'admin', 'none'
  tokenVersion     Int      @default(0)
  isSuspended      Boolean  @default(false)
  suspensionReason String?
  isOnline         Boolean  @default(false)
  studentBranch    String?
  section          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  lastLogin        DateTime?
  quizzes          Quiz[]
  results          Result[]
}

model Quiz {
  id               String   @id @default(uuid())
  title            String
  description      String?
  questions        Json     // Stores the array of questions
  createdBy        User     @relation(fields: [createdById], references: [id])
  createdById      String
  isActive         Boolean  @default(true)
  joinCode         String?  @unique
  difficulty       String   @default("Medium")
  timerPerQuestion Int      @default(30)
  duration         Int      @default(0)
  topic            String?
  isLive           Boolean  @default(false)
  isAssessment     Boolean  @default(false)
  status           String   @default("waiting") // 'waiting', 'started', 'finished'
  createdAt        DateTime @default(now())
  finalLeaderboard Json?    // Stores the leaderboard array
  finalInsights    Json?    // Stores the insights object
  results          Result[]
}

model Result {
  id             String    @id @default(uuid())
  quiz           Quiz      @relation(fields: [quizId], references: [id])
  quizId         String
  student        User      @relation(fields: [studentId], references: [id])
  studentId      String
  score          Int       @default(0)
  totalQuestions Int
  totalTimeTaken Int       @default(0)
  answers        Json      // Stores the answers array
  status         String    @default("in-progress") // 'in-progress', 'completed'
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  lastAnsweredAt DateTime  @default(now())
}
